# 数据库配置
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=muse

# Neo4j 配置
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# 后端配置
BACKEND_PORT=8085
BACKEND_API_BASE=http://localhost:8085/api/v1

# 前端配置
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8085

# Morph-KGC 配置
MORPH_KGC_PORT=5000
KG_DATA_DIR=./知识图谱/kg_data
KG_OUTPUT_DIR=./知识图谱/output

# 环境模式
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev
